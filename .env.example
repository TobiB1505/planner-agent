# Backend-Konfiguration (vom Projektstamm aus geladen, siehe backend/api.py
# und backend/run_local.py). Kopiere diese Datei nach .env und trage lokale
# Werte ein - .env selbst wird nicht versioniert.

# local | preview | production - siehe docs/deployment/ENVIRONMENTS.md.
# Leer/unbekannt wird wie "local" behandelt. Steuert u.a., ob PLANNER_DATA_DIR
# explizit gesetzt sein muss (siehe backend/run_local.py:
# check_data_dir_for_environment) und den Default von SYSTEM_RESTART_ENABLED.
APP_ENV=local

# PFLICHT: Verbindung zur operativen PostgreSQL-Datenbank.
# Format (nur Beispiel, KEINE echten Zugangsdaten hier eintragen und niemals
# committen):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# In Preview/Production ausschließlich als Environment Variable der
# Hosting-Plattform setzen (Render Secret), nie im Repository.
# Supabase-Einrichtung Schritt für Schritt: docs/database/SUPABASE_SETUP.md
DATABASE_URL=

# Optional: Größe des Connection Pools. Render betreibt einen langlebigen
# Prozess, Supabase hat harte Verbindungslimits - deshalb bewusst klein halten.
# Defaults: min 1, max 5.
DATABASE_POOL_MIN_SIZE=
DATABASE_POOL_MAX_SIZE=

# Nur für die Testsuite: eigene PostgreSQL-Datenbank, die gefahrlos angelegt
# und wieder geleert werden darf. Wird NIE auf eine Produktionsdatenbank
# gesetzt - backend/tests/conftest.py bricht bei erkennbaren Produktionshosts
# hart ab. Ohne Wert nutzen die Tests
# postgresql://postgres@127.0.0.1:5432/planner_test.
TEST_DATABASE_URL=

# Google Gemini API-Key für die KI-gestützte PDF-Extraktion (optional -
# ohne Key funktioniert die lokale Nicht-KI-Fallback-Erkennung weiterhin).
GEMINI_API_KEY=

# Ordner für lokale Laufzeitdaten (Archiv, Uploads, Exporte, Alt-Backups).
# Die Datenbank liegt seit der PostgreSQL-Migration NICHT mehr hier - dafür ist
# ausschließlich DATABASE_URL zuständig.
# - APP_ENV=local: leer lassen = Standard local_data/ im Projektstamm.
# - APP_ENV=preview/production: PFLICHT. Ob dieser Ordner weiterhin auf einem
#   persistenten Volume liegen muss, hängt an den verbliebenen Datei-Workflows -
#   siehe docs/database/POSTGRES_STORAGE_GAPS.md.
PLANNER_DATA_DIR=

# Erlaubte Browser-Origins für direkte Backend-Anfragen (kommasepariert).
# Wird nur für CORS gebraucht - der normale Next.js-Rewrite läuft ohnehin
# same-origin und ist davon nicht betroffen.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Adresse, unter der backend/run_local.py das Backend startet.
# Im Container: 0.0.0.0 (siehe backend/Dockerfile) statt 127.0.0.1.
BACKEND_HOST=127.0.0.1
# Port-Priorität in backend/run_local.py: PORT (von Hosting-Plattformen wie
# Render/Railway/Fly injiziert) vor BACKEND_PORT vor Default 8000.
BACKEND_PORT=8000

# Nur für aktive Entwicklung: 1 aktiviert Auto-Neustart bei Code-Änderungen.
# Für normale Nutzung aus (Standard) - der "Backend neu starten"-Button im
# Service Manager (/system) funktioniert unabhängig davon immer.
BACKEND_RELOAD=0

# Steuert POST /api/system/restart (os.execv-Prozessneustart):
# - "1": Neustart ausführen (bisheriges Verhalten).
# - "0": Neustart ablehnen, Antwort verweist auf die Restart-Funktion der
#   Hosting-Plattform - für Preview/Production, wo os.execv keinen Sinn
#   ergibt (kein langlebiger, selbst verwalteter Prozess).
# Ohne explizite Einstellung: aktiv nur bei APP_ENV=local.
SYSTEM_RESTART_ENABLED=

# --- Supabase Auth (Backend-Seite) ------------------------------------------
# Das Backend verifiziert Access Tokens selbst - siehe backend/auth/ und
# docs/auth/SUPABASE_AUTH_SETUP.md. Ohne diese Werte ist keine Verifikation
# möglich; die Anwendung startet trotzdem, antwortet dann aber auf jedem
# geschützten Endpunkt mit 401 (fail-closed, kein "Auth aus"-Schalter).

# Projekt-URL, z.B. https://<projekt-ref>.supabase.co
# Daraus werden Issuer (<url>/auth/v1) und JWKS-URL abgeleitet.
SUPABASE_URL=

# Nur setzen, wenn der Issuer vom Standard abweicht (eigene Domain o.ä.).
SUPABASE_JWT_ISSUER=

# Optional. Standard: authenticated (so gibt Supabase Access Tokens aus).
SUPABASE_JWT_AUDIENCE=

# Optional, nur für ältere Supabase-Projekte mit symmetrischem JWT-Secret
# (HS256). Projekte mit asymmetrischen Signaturschlüsseln brauchen das nicht -
# dort läuft alles über die öffentliche JWKS-URL. Ein gesetztes Secret ist ein
# echtes Geheimnis: nie ins Frontend, nie ins Repository.
SUPABASE_JWT_SECRET=

# BEWUSST NICHT VORGESEHEN: SUPABASE_SERVICE_ROLE_KEY.
# Für die Token-Verifikation wird er nicht gebraucht (JWKS ist öffentlich),
# und was nicht konfiguriert ist, kann auch nicht verloren gehen. Sollte ein
# späterer Sprint ihn wirklich brauchen (z.B. Anlegen von Auth-Benutzern aus
# der Admin-UI), gehört diese Entscheidung ausdrücklich dokumentiert.
