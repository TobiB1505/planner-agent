# Frontend-Konfiguration. Kopiere diese Datei nach frontend/.env.local und
# trage lokale Werte ein, falls die Standardwerte nicht passen.
#
# Wichtig: NICHT mit NEXT_PUBLIC_ versehen - diese Variable wird nur vom
# Next.js-Server für den next.config.ts-Rewrite gelesen, nie an den Browser
# ausgeliefert. Der Browser selbst spricht immer nur relative /api/...-Pfade
# an, siehe frontend/lib/api.ts.

# local | preview | production - siehe docs/deployment/ENVIRONMENTS.md.
# Lokal leer lassen (Default: "local"). Auf Vercel wird dies über die
# Preview-/Production-Environment-Variablen des Projekts gesetzt, nicht
# automatisch aus VERCEL_ENV abgeleitet.
APP_ENV=

# Wohin der Next.js-Server /api/...-Aufrufe serverseitig weiterleitet
# (next.config.ts, siehe frontend/lib/backend-url.ts).
# - APP_ENV=local (oder leer): optional, Default http://127.0.0.1:8000.
# - APP_ENV=preview/production: PFLICHT (nur http:// oder https://,
#   kein impliziter Fallback auf localhost) - der Build/Start bricht sonst
#   mit einer klaren Fehlermeldung ab.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
