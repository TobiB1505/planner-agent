# Frontend-Konfiguration. Kopiere diese Datei nach frontend/.env.local und
# trage lokale Werte ein, falls die Standardwerte nicht passen.
#
# Wichtig: NICHT mit NEXT_PUBLIC_ versehen - diese Variable wird nur vom
# Next.js-Server für den next.config.ts-Rewrite gelesen, nie an den Browser
# ausgeliefert. Der Browser selbst spricht immer nur relative /api/...-Pfade
# an, siehe frontend/lib/api.ts.

# Wohin der lokale Next.js-Server /api/...-Aufrufe weiterleitet.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
